---
const casos = [
  { 
    title: "The Elemental Race - Landing Page", 
    role: "Frontend Developer",
    context: "Lanzamiento de un evento deportivo de MTB XCO para Movil Cycle que requería un diseño adaptativo y una vía rápida de inscripción directa.", 
    solution: "Desarrollo desde cero con enfoque Mobile First usando CSS Grid y Flexbox. Se implementó navegación dinámica con JS y enlaces de inscripción conectados a la API de WhatsApp.",
    tags: ["HTML5", "CSS3", "JavaScript", "WhatsApp API"],
    link: "#" // Aquí pondrás el link real cuando lo subas
  },
  { 
    title: "Distrilab Ortiz - E-commerce Corporativo", 
    role: "Desarrolladora Web End-to-End",
    context: "Necesidad de una tienda online corporativa funcional y un sistema de cotizaciones directas para clientes.", 
    solution: "Gestión completa de infraestructura (hosting/dominio) y desarrollo en WordPress con WooCommerce. Se integró un sistema de cotizaciones por WhatsApp y se definieron roles de seguridad.",
    tags: ["WordPress", "WooCommerce", "Hosting"],
    link: "#"
  },
  { 
    title: "Gran Fondo Beyond - Gestión y Automatización", 
    role: "Gestión Web & Operaciones",
    context: "Control exhaustivo de inscripciones y atención al público masivo para el evento deportivo.", 
    solution: "Implementación de flujos de mensajería automatizada y manejo de bases de datos para evaluación estadística, reduciendo las incidencias y confirmando pagos eficientemente.",
    tags: ["n8n", "Bases de Datos", "Automatización"],
    link: "#"
  }
];
---
<section id="casos-de-estudio" class="py-24 px-6 bg-[#020617]">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-white mb-12 flex items-center gap-3">
      <svg class="w-8 h-8 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
      Casos de <span class="text-purple-600">Estudio</span>
    </h2>
    
    <div class="space-y-12">
      {casos.map(caso => (
        <article class="bg-[#0f172a] border border-slate-800 rounded-2xl p-8 hover:border-sky-900 transition-colors">
          <div class="flex flex-col md:flex-row justify-between items-start gap-4 mb-6">
            <div>
              <h3 class="text-2xl font-bold text-white mb-2">{caso.title}</h3>
              <span class="text-yellow-400 font-mono text-sm">{caso.role}</span>
            </div>
            {/* Solo mostramos el botón si hay un link válido, por ahora dejará el # */}
            <a href={caso.link} class="text-sm font-bold text-white bg-slate-800 hover:bg-purple-600 px-4 py-2 rounded-lg transition border border-slate-700 hover:border-purple-400">Ver Proyecto →</a>
          </div>

          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <div>
              <h4 class="text-slate-200 font-bold mb-2">El Problema / Contexto</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{caso.context}</p>
            </div>
            <div>
              <h4 class="text-slate-200 font-bold mb-2">La Solución</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{caso.solution}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 pt-6 border-t border-slate-800/60 mt-auto">
            <span class="text-xs text-slate-500 uppercase tracking-wider font-bold mr-2 mt-1">Stack:</span>
            {caso.tags.map(tag => (
              <span class="text-xs font-mono text-white bg-purple-950/30 px-3 py-1 rounded-md border border-purple-900/50">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>