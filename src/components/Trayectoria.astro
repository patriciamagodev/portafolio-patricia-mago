---
const experiencias = [
  { 
    fecha: "Feb 2026 - Abr 2026", 
    titulo: "Área de Eventos & Automatización | Movil Cycle", 
    desc: "Control de inscripciones vía web, automatización de mensajería, manejo de bases de datos estadísticas y logística integral de eventos deportivos[cite: 14]." 
  },
  { 
    fecha: "May 2024 - Jun 2024", 
    titulo: "Área Web | Distrilab Ortiz", 
    desc: "Desarrollo de e-commerce corporativo, configuración de servidores VPS, integración de sistemas de cotización y capacitación de usuarios[cite: 14]." 
  },
  { 
    fecha: "Feb 2024 - Mar 2025", 
    titulo: "Diseñadora Web | Laboratorio J&M", 
    desc: "Creación de infraestructura web inicial, diseño de interfaces enfocadas en UX y conexión de plataformas con canales de atención directa[cite: 14]." 
  },
  { 
    fecha: "Oct 2005 - Mar 2016", 
    titulo: "Licenciada en Comunicación Social | USM", 
    desc: "Formación en estrategia corporativa, gestión de crisis, identidad institucional y creación de campañas de alto impacto[cite: 14]." 
  },
];
---
<section id="trayectoria" class="py-24 px-6 bg-[#0a1120] text-white">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl font-bold tracking-tight text-center mb-16 flex items-center justify-center gap-3">
      <svg class="w-9 h-9 text-sky-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
      Mi <span class="text-sky-400">Trayectoria</span>
    </h2>

    <div class="space-y-12 relative before:absolute before:inset-y-0 before:left-4 before:w-0.5 before:bg-slate-700 md:before:left-1/2 md:before:-ml-px">
      {experiencias.map((exp, index) => (
        <div class={`relative flex flex-col md:flex-row items-center ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
          
          {/* Círculo de la línea de tiempo */}
          <div class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 bg-cyan-400 rounded-full border-4 border-[#0a1120] z-10 md:left-1/2 md:-ml-2"></div>
          
          {/* Tarjeta de contenido */}
          <div class={`w-full pl-12 md:w-1/2 md:pl-0 ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'}`}>
            <div class="bg-slate-800 p-6 rounded-lg border border-slate-700 shadow-xl group hover:border-cyan-400 transition">
              <span class="text-sm font-mono text-cyan-400">{exp.fecha}</span>
              <h3 class="text-xl font-bold text-slate-100 mt-1 mb-2 group-hover:text-cyan-300">{exp.titulo}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{exp.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>